{
  "name": "@ohmuzakie/crucible-cli",
  "private": false,
  "version": "0.2.2",
  "type": "module",
  "bin": {
    "crucible": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "logo.txt"
  ],
  "scripts": {
    "prepare:web": "node scripts/prepare-local-web.mjs",
    "build": "pnpm prepare:web && esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --sourcemap --outfile=dist/index.js && esbuild src/workspace-server.ts --bundle --platform=node --format=esm --packages=bundle --sourcemap --outfile=dist/workspace-server.js",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": "./dist/index.js",
    "./workspace-server": "./dist/workspace-server.js"
  },
  "dependencies": {
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@crucible/ai": "workspace:*",
    "@crucible/certificate": "workspace:*",
    "@crucible/core": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
