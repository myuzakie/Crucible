{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "test:smoke:monad": "node --env-file-if-exists=.env --import tsx scripts/smoke-monad.ts",
    "build": "tsc --noEmit && pnpm --filter @crucible/web build",
    "crucible": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "viem": "^2.57.4"
  }
}
