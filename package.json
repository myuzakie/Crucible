{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "demo:check": "tsx scripts/demo-check.ts",
    "test:smoke:monad": "node --env-file-if-exists=.env --import tsx scripts/smoke-monad.ts",
    "test:contracts": "forge test --root examples/monad-erc20-demo && forge test --root examples/monad-certificate-registry",
    "test:registry:local": "node --import tsx scripts/smoke-certificate-registry.ts",
    "build": "tsc --noEmit && pnpm --filter @crucible/web build && pnpm web:check",
    "cli:build": "pnpm --filter @crucible/cli build",
    "cli:pack": "pnpm --filter @crucible/cli pack",
    "web:check": "tsx scripts/web-deploy-check.ts",
    "crucible": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "viem": "^2.57.4"
  }
}
