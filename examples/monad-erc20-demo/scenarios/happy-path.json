{
  "schemaVersion": "0.1",
  "name": "token-happy-path",
  "network": "local",
  "actors": {
    "deployer": "env:DEPLOYER_PRIVATE_KEY",
    "alice": "env:ALICE_PRIVATE_KEY"
  },
  "nodes": [
    {
      "id": "deploy",
      "type": "deploy",
      "contract": "Token",
      "args": [],
      "after": []
    },
    {
      "id": "mint",
      "type": "call",
      "from": "deployer",
      "to": "deploy",
      "fn": "mint",
      "args": ["alice", "1000"],
      "after": ["deploy"]
    },
    {
      "id": "balance",
      "type": "assert",
      "check": {
        "fn": "balanceOf",
        "args": ["alice"],
        "eq": "1000"
      },
      "after": ["mint"]
    }
  ]
}
