MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/
MONAD_CHAIN_ID=10143
DEPLOYER_PRIVATE_KEY=
ALICE_PRIVATE_KEY=

# Optional server-side AI diagnosis (never expose these in VITE_* variables).
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions

# Optional local runner override
# LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional certificate signing (path to PKCS8 PEM). Never commit the private key.
# CERTIFICATE_PRIVATE_KEY_PATH=./certificate-private.pem

# Dedicated Monad testnet wallets only. Addresses are derived automatically.
# Fund both wallets from https://faucet.monad.xyz/add-network when needed.
# Never commit .env or print private keys in logs/results.
